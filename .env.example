# Port HTTP local (nginx fait le reverse proxy devant)
PORT=3000
# Adresse d'écoute (127.0.0.1 si seul nginx doit y accéder)
HOST=127.0.0.1
# Chemin de la base SQLite
DB_PATH=./data/blindtest.db
# Secret de signature des cookies : mets une longue chaîne aléatoire
# (ex : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=change-moi
# true si le site est servi en HTTPS (Cloudflare Tunnel) : cookies "Secure"
SECURE_COOKIES=true
# Faire confiance au reverse proxy local pour l'IP client
TRUST_PROXY=true
# Nombre minimum de joueurs connectés pour lancer une partie
MIN_PLAYERS_TO_START=2
